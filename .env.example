# Copy to .env and fill. NEVER commit .env
# Supabase (get from supabase.com -> Project -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...  # server only, GitHub Secret, NOT in app

# Mapbox (free: mapbox.com -> Tokens)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# RazorpayX (test then live: dashboard.razorpay.com)
RAZORPAYX_KEY_ID=rzp_test_...
RAZORPAYX_KEY_SECRET=...  # GitHub Secret, server only

# Web (Vercel env)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
NEXT_PUBLIC_APP_NAME=Ride Media
